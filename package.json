{
	"name": "n8n-nodes-signalpipe",
	"version": "0.1.0",
	"description": "SignalPipe for n8n: judge whether the author of any text is a real buyer for your product, and act on the buyers SignalPipe finds.",
	"license": "MIT",
	"homepage": "https://signalpipe.io",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"signalpipe",
		"buying-intent",
		"lead-generation",
		"sales"
	],
	"author": {
		"name": "SignalPipe",
		"email": "contact@signalpipe.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AbYousef739/n8n-nodes-signalpipe.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SignalPipeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SignalPipe/SignalPipe.node.js",
			"dist/nodes/SignalPipeTrigger/SignalPipeTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.49.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
